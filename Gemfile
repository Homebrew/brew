# frozen_string_literal: true

# This file exists only so tools that auto-discover `./Gemfile` (e.g. Ruby
# LSP) find the right one without needing a per-tool path override. Don't run
# `bundle install`/`update` here directly: use `brew install-bundler-gems`,
# which targets `Library/Homebrew/Gemfile` explicitly.
eval_gemfile "Library/Homebrew/Gemfile"
